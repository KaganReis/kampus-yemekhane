{
  "name": "yemekhane",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-status-bar": "~58.0.4",
    "firebase": "^13.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:pages": "EXPO_BASE_URL=/kampus-yemekhane expo export -p web --output-dir dist-pages && node scripts/prepare-pages.mjs",
    "emulators": "PATH=/opt/homebrew/opt/openjdk@21/bin:$PATH npx --yes firebase-tools@latest emulators:start --only auth,firestore",
    "web:emulator": "EXPO_PUBLIC_FIREBASE_EMULATOR=1 expo start --web"
  },
  "private": true
}
